{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartCityCuritibaTelemetryPayload",
  "description": "Contrato de Dados de Integração entre Automação (MQTT/IoT), Computação (SUMO/TraCI) e Mecânica (Emissões/Ruído) conforme Seção 5.2 do Manual do Projeto.",
  "type": "object",
  "required": [
    "timestamp",
    "intersection_id",
    "sensors",
    "instantaneous_metrics"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO-8601 UTC da leitura (ex: 2026-08-21T17:30:00Z)"
    },
    "intersection_id": {
      "type": "string",
      "description": "Identificador único do cruzamento ou semáforo monitorado (ex: cruzamento_rua_xv_floriano)"
    },
    "scenario": {
      "type": "string",
      "enum": ["as_is", "to_be"],
      "description": "Cenário da simulação"
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sensor_id", "state", "vehicle_speed_kmh"],
        "properties": {
          "sensor_id": {
            "type": "string"
          },
          "lane_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["occupied", "free"]
          },
          "vehicle_speed_kmh": {
            "type": "number",
            "minimum": 0
          },
          "vehicle_count": {
            "type": "integer",
            "minimum": 0
          },
          "bus_detected": {
            "type": "boolean"
          }
        }
      }
    },
    "instantaneous_metrics": {
      "type": "object",
      "required": ["queue_length_meters", "co2_grams_per_second"],
      "properties": {
        "queue_length_meters": {
          "type": "number",
          "minimum": 0
        },
        "co2_grams_per_second": {
          "type": "number",
          "minimum": 0
        },
        "nox_mg_per_second": {
          "type": "number",
          "minimum": 0
        },
        "pmx_mg_per_second": {
          "type": "number",
          "minimum": 0
        },
        "noise_dba": {
          "type": "number",
          "minimum": 0
        },
        "waiting_time_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
